# Game configuration, applied when "New game" starts.
# Separators: spaces only, no tabs. Colors: <R> <G> <B> <A>, 0-255,
# no color names. "#" at line start = comment.
#
# ROOM <room>               required, starting room (dir in rooms/)
# MUSIC <name>              optional game music: .ogg name in game/,
#                           or a full romfs:/ path with its extension
# ITEM <id>                 optional, starting item (max 16, one per line)
# SAVE sdmc:/<file>         optional, enables saving and CONTINUE
# CANNOT_USE_MESSAGE <key>  optional, shown when an item has no use there
#
# MESSAGE ... END_MESSAGE   optional, message box text
#   TEXT_COLOR <rgba>       text color (default 255 255 255 255)
#   TEXT_SIZE <scale>       text scale (default 0.6)
#
# CHOICE ... END_CHOICE     optional, choice box (CHOICE action) and
#                           Start menu
#   FRAME_WIDTH <px>        box width, centered (default 276)
#   PROMPT_TEXT_COLOR <rgba>  question color (default 255 255 255 255)
#   PROMPT_TEXT_SIZE <scale>  question scale (default 0.6)
#   BUTTON_TEXT_COLOR <rgba>  option color (default 255 255 255 255)
#   BUTTON_TEXT_SIZE <scale>  option scale (default 0.6)
#   BUTTON_COLOR <rgba>     behind the selected option (default 105 82 40 255)
#   BUTTON_PADDING <px>     margin around an option (default 5)
#
# FRAME_COLORS ... END_FRAME_COLORS   required, frame layers (out -> in);
#                                     a missing layer is not drawn
#   SHADOW <rgba>           drop shadow
#   OUTER_BORDER <rgba>     2 px border
#   OUTER_BACKGROUND <rgba> 3 px between the borders
#   INNER_BORDER <rgba>     1 px border
#   INNER_BACKGROUND <rgba> behind the text

ROOM sample1
#SAVE sdmc:/moteur.save
MESSAGE
    TEXT_COLOR 255 255 255 255
    TEXT_SIZE 0.5
END_MESSAGE
CHOICE
    FRAME_WIDTH 260
    BUTTON_TEXT_COLOR 255 255 255 255
    BUTTON_TEXT_SIZE 0.5
    BUTTON_COLOR 105 82 40 255
    PROMPT_TEXT_COLOR 255 255 255 255
    PROMPT_TEXT_SIZE 0.5
    BUTTON_PADDING 5
END_CHOICE
FRAME_COLORS
    SHADOW 0 0 0 150
    OUTER_BORDER 150 120 55 255
    OUTER_BACKGROUND 18 24 34 235
    INNER_BORDER 105 82 40 255
    INNER_BACKGROUND 22 28 40 245
END_FRAME_COLORS
