CHOICE MAIN
    PROMPT DUSTBIN_WHAT_TO_DO

    OPTION EMPTY_BIN
        CHOICE WHERE
        MESSAGE LETS_GIVE_UP
    END_OPTION

    OPTION THROW_CAN
        WHEN INVENTORY_HAS EMPTY_BEER true
        MESSAGE NO_PLACE
    END_OPTION

    OPTION LEAVE
        EXIT_CHOICE
    END_OPTION
END_CHOICE

CHOICE WHERE
    PROMPT DUSTBIN_WHERE_TO_THROW

    OPTION NEIGHBOR_BIN
        MESSAGE TOO_FAR
    END_OPTION

    OPTION PAVEMENT
        MESSAGE WAY_TOO_FAR
    END_OPTION

    OPTION GIVE_UP
        EXIT_CHOICE
    END_OPTION
END_CHOICE
