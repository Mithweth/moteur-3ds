IMAGE background 0 0 0
WHEN STATE_IS raytracing_enabled false
END_IMAGE

IMAGE background_rt 0 0 0
WHEN STATE_IS raytracing_enabled true
END_IMAGE

IMAGE beer_rt 180 129 0.1
WHEN STATE_IS raytracing_enabled true
END_IMAGE

IMAGE empty_beer 99 211 0.1
	WHEN STATE_IS raytracing_enabled false
	WHEN INVENTORY_HAS EMPTY_BEER false
END_IMAGE

